{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noEmptyInterface": "off",
        "noImportCycles": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":PACKAGE:"],
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"],
              ":BLANK_LINE:",
              [":BUN:", ":NODE:"]
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["daemon/drizzle/meta/**"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["biome.json"],
      "formatter": {
        "lineWidth": 80
      }
    },
    {
      "includes": ["**/tsconfig*json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.svg"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["daemon/src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/plugins/**",
                      "**/trpc/**",
                      "**/kernel.js",
                      "**/app.js",
                      "**/config.js"
                    ],
                    "message": "core \u53ea\u5305\u542b\u4e0e\u5e94\u7528\u65e0\u5173\u7684\u57fa\u7840\u4ee3\u7801\uff0c\u4e0d\u80fd\u4f9d\u8d56\u5e94\u7528\u6a21\u5757\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["daemon/src/plugins/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@trpc/server", "@trpc/server/*", "**/trpc/**"],
                    "message": "\u4e1a\u52a1\u4ee3\u7801\u4e0d\u4f9d\u8d56 tRPC\uff0c\u4f20\u8f93\u5c42\u6620\u5c04\u653e\u5728\u6a21\u5757\u7684 router.ts \u4e2d\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["daemon/src/plugins/database/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@trpc/server", "@trpc/server/*", "**/trpc/**"],
                    "message": "\u4e1a\u52a1\u4ee3\u7801\u4e0d\u4f9d\u8d56 tRPC\uff0c\u4f20\u8f93\u5c42\u6620\u5c04\u653e\u5728\u6a21\u5757\u7684 router.ts \u4e2d\u3002"
                  },
                  {
                    "group": [
                      "**/auth/**",
                      "**/billing/**",
                      "**/catalog/**",
                      "**/gateway/**",
                      "**/http/**",
                      "**/keys/**",
                      "**/outbound/**",
                      "**/pricing/**",
                      "**/subscription/**",
                      "**/users/**",
                      "**/vault/**",
                      "**/wallet/**"
                    ],
                    "message": "\u6570\u636e\u5e93\u5c42\u4e0d\u4f9d\u8d56\u4e1a\u52a1\u6a21\u5757\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["daemon/src/plugins/billing/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@trpc/server", "@trpc/server/*", "**/trpc/**"],
                    "message": "\u4e1a\u52a1\u4ee3\u7801\u4e0d\u4f9d\u8d56 tRPC\uff0c\u4f20\u8f93\u5c42\u6620\u5c04\u653e\u5728\u6a21\u5757\u7684 router.ts \u4e2d\u3002"
                  },
                  {
                    "group": ["**/gateway/**"],
                    "message": "\u8ba1\u8d39\u4e0d\u4f9d\u8d56\u7f51\u5173\uff1b\u5171\u4eab\u7684\u7528\u91cf\u4e0e\u8def\u7531\u903b\u8f91\u5f52\u5c5e\u8ba1\u8d39\u6a21\u5757\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["daemon/src/plugins/gateway/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@trpc/server", "@trpc/server/*", "**/trpc/**"],
                    "message": "\u4e1a\u52a1\u4ee3\u7801\u4e0d\u4f9d\u8d56 tRPC\uff0c\u4f20\u8f93\u5c42\u6620\u5c04\u653e\u5728\u6a21\u5757\u7684 router.ts \u4e2d\u3002"
                  },
                  {
                    "group": ["**/subscription/**"],
                    "message": "\u7f51\u5173\u901a\u8fc7 SubscriptionChannels \u63a5\u53e3\u4f7f\u7528\u8ba2\u9605\u6e20\u9053\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "daemon/src/plugins/*/index.ts",
        "daemon/src/plugins/*/router.ts",
        "daemon/src/plugins/http/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
