{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noEmptyInterface": "off",
        "noImportCycles": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":PACKAGE:"],
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"],
              ":BLANK_LINE:",
              [":BUN:", ":NODE:"]
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["daemon/drizzle/meta/**"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["biome.json"],
      "formatter": {
        "lineWidth": 80
      }
    },
    {
      "includes": ["**/tsconfig*json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.svg"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["daemon/src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/plugins/**",
                      "**/trpc/**",
                      "**/openapi/**",
                      "**/kernel.ts",
                      "**/app.ts",
                      "**/config.ts"
                    ],
                    "message": "core \u53ea\u5305\u542b\u4e0e\u5e94\u7528\u65e0\u5173\u7684\u57fa\u7840\u4ee3\u7801\uff0c\u4e0d\u80fd\u4f9d\u8d56\u5e94\u7528\u6a21\u5757\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/protocols/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/daemon/**", "**/web/**", "@ohmyapi/*"],
                    "message": "protocols \u53ea\u63cf\u8ff0 API \u534f\u8bae\uff0c\u4e0d\u4f9d\u8d56\u5176\u4ed6\u5305\u548c\u5e94\u7528\u3002"
                  },
                  {
                    "group": [
                      "@fraqjs/*",
                      "hono",
                      "hono/*",
                      "@hono/*",
                      "@trpc/*",
                      "drizzle-orm",
                      "drizzle-orm/*",
                      "pg",
                      "undici"
                    ],
                    "message": "\u5171\u4eab\u5305\u4e0d\u4f9d\u8d56\u5e94\u7528\u6846\u67b6\u3001\u5b58\u50a8\u548c\u51fa\u7ad9\u7f51\u7edc\u5e93\uff0c\u8fd9\u4e9b\u7531\u4f7f\u7528\u65b9\u63d0\u4f9b\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/relay/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/daemon/**",
                      "**/web/**",
                      "@ohmyapi/daemon",
                      "@ohmyapi/daemon/*"
                    ],
                    "message": "relay \u53ea\u4f9d\u8d56 @ohmyapi/protocols\uff0c\u4e0d\u4f9d\u8d56\u5e94\u7528\u3002"
                  },
                  {
                    "group": [
                      "@fraqjs/*",
                      "hono",
                      "hono/*",
                      "@hono/*",
                      "@trpc/*",
                      "drizzle-orm",
                      "drizzle-orm/*",
                      "pg",
                      "undici"
                    ],
                    "message": "\u5171\u4eab\u5305\u4e0d\u4f9d\u8d56\u5e94\u7528\u6846\u67b6\u3001\u5b58\u50a8\u548c\u51fa\u7ad9\u7f51\u7edc\u5e93\uff0c\u8fd9\u4e9b\u7531\u4f7f\u7528\u65b9\u63d0\u4f9b\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["daemon/src/plugins/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@trpc/server", "@trpc/server/*", "**/trpc/**"],
                    "message": "\u4e1a\u52a1\u4ee3\u7801\u4e0d\u4f9d\u8d56 tRPC\uff0c\u4f20\u8f93\u5c42\u6620\u5c04\u653e\u5728\u6a21\u5757\u7684 router.ts \u4e2d\u3002"
                  },
                  {
                    "group": ["@hono/zod-openapi", "**/openapi/**"],
                    "message": "\u4e1a\u52a1\u4ee3\u7801\u4e0d\u4f9d\u8d56\u516c\u5f00 API \u7684\u4f20\u8f93\u5c42\uff0c\u6620\u5c04\u653e\u5728\u6a21\u5757\u7684 api.ts \u4e2d\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["daemon/src/plugins/database/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@trpc/server", "@trpc/server/*", "**/trpc/**"],
                    "message": "\u4e1a\u52a1\u4ee3\u7801\u4e0d\u4f9d\u8d56 tRPC\uff0c\u4f20\u8f93\u5c42\u6620\u5c04\u653e\u5728\u6a21\u5757\u7684 router.ts \u4e2d\u3002"
                  },
                  {
                    "group": ["@hono/zod-openapi", "**/openapi/**"],
                    "message": "\u4e1a\u52a1\u4ee3\u7801\u4e0d\u4f9d\u8d56\u516c\u5f00 API \u7684\u4f20\u8f93\u5c42\uff0c\u6620\u5c04\u653e\u5728\u6a21\u5757\u7684 api.ts \u4e2d\u3002"
                  },
                  {
                    "group": [
                      "**/auth/**",
                      "**/billing/**",
                      "**/catalog/**",
                      "**/gateway/**",
                      "**/http/**",
                      "**/keys/**",
                      "**/moderation/**",
                      "**/outbound/**",
                      "**/pricing/**",
                      "**/subscription/**",
                      "**/users/**",
                      "**/vault/**",
                      "**/wallet/**"
                    ],
                    "message": "\u6570\u636e\u5e93\u5c42\u4e0d\u4f9d\u8d56\u4e1a\u52a1\u6a21\u5757\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["daemon/src/plugins/billing/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@trpc/server", "@trpc/server/*", "**/trpc/**"],
                    "message": "\u4e1a\u52a1\u4ee3\u7801\u4e0d\u4f9d\u8d56 tRPC\uff0c\u4f20\u8f93\u5c42\u6620\u5c04\u653e\u5728\u6a21\u5757\u7684 router.ts \u4e2d\u3002"
                  },
                  {
                    "group": ["@hono/zod-openapi", "**/openapi/**"],
                    "message": "\u4e1a\u52a1\u4ee3\u7801\u4e0d\u4f9d\u8d56\u516c\u5f00 API \u7684\u4f20\u8f93\u5c42\uff0c\u6620\u5c04\u653e\u5728\u6a21\u5757\u7684 api.ts \u4e2d\u3002"
                  },
                  {
                    "group": ["**/gateway/**"],
                    "message": "\u8ba1\u8d39\u4e0d\u4f9d\u8d56\u7f51\u5173\uff1b\u5171\u4eab\u7684\u7528\u91cf\u4e0e\u8def\u7531\u903b\u8f91\u5f52\u5c5e\u8ba1\u8d39\u6a21\u5757\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["daemon/src/plugins/gateway/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@trpc/server", "@trpc/server/*", "**/trpc/**"],
                    "message": "\u4e1a\u52a1\u4ee3\u7801\u4e0d\u4f9d\u8d56 tRPC\uff0c\u4f20\u8f93\u5c42\u6620\u5c04\u653e\u5728\u6a21\u5757\u7684 router.ts \u4e2d\u3002"
                  },
                  {
                    "group": ["@hono/zod-openapi", "**/openapi/**"],
                    "message": "\u4e1a\u52a1\u4ee3\u7801\u4e0d\u4f9d\u8d56\u516c\u5f00 API \u7684\u4f20\u8f93\u5c42\uff0c\u6620\u5c04\u653e\u5728\u6a21\u5757\u7684 api.ts \u4e2d\u3002"
                  },
                  {
                    "group": ["**/subscription/**"],
                    "message": "\u7f51\u5173\u901a\u8fc7 SubscriptionChannels \u63a5\u53e3\u4f7f\u7528\u8ba2\u9605\u6e20\u9053\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "daemon/src/plugins/*/index.ts",
        "daemon/src/plugins/*/router.ts",
        "daemon/src/plugins/*/api.ts",
        "daemon/src/plugins/http/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["web/src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../routes", "../routes/*"],
                    "message": "\u9875\u9762\u53ea\u7531 main.tsx \u88c5\u914d\uff1b\u5171\u4eab\u7684\u754c\u9762\u653e\u5728 components/\u3002"
                  },
                  {
                    "group": ["../components", "../components/*"],
                    "message": "lib/ \u53ea\u653e\u6570\u636e\u4e0e\u5de5\u5177\u51fd\u6570\uff0c\u4e0d\u4f9d\u8d56\u754c\u9762\u7ec4\u4ef6\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["web/src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../routes", "../routes/*"],
                    "message": "\u9875\u9762\u53ea\u7531 main.tsx \u88c5\u914d\uff1b\u5171\u4eab\u7684\u754c\u9762\u653e\u5728 components/\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["web/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./*"],
                    "message": "\u9875\u9762\u4e4b\u95f4\u4e0d\u4e92\u76f8\u5bfc\u5165\uff1b\u5171\u4eab\u7684\u754c\u9762\u653e\u5728 components/\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
