{
  "name": "@ohmyapi/protocols",
  "version": "0.1.0",
  "description": "Descriptions of the LLM API protocols served by the ohmyapi gateway",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@ohmyapi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
