{
  "name": "@ohmyapi/relay",
  "version": "0.1.0",
  "description": "Request lifecycle and response relaying for LLM API gateways",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@ohmyapi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ohmyapi/protocols": "workspace:^"
  }
}
