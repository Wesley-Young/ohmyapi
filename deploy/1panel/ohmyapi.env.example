# Copy to secrets/ohmyapi.env and restrict the file to the deployment owner.
# Create a non-superuser role and URL-encode its password in DATABASE_URL.
DATABASE_URL=postgresql://ohmyapi_app:URL_ENCODED_PASSWORD@db:5432/ohmyapi
APP_ORIGIN=https://ohmyapi.example.com
SESSION_COOKIE_SECURE=true
# Copy the existing production key. Never generate a new key for an existing database.
CHANNEL_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_64_HEX_CHARACTER_KEY
# Copy any other production settings from the existing deployment.
BILLING_CURRENCY=USD
