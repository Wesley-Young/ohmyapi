{
  "name": "ohmyapi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ohmyapi/daemon --filter @ohmyapi/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @ohmyapi/daemon start",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d --wait db",
    "db:generate": "pnpm --filter @ohmyapi/daemon db:generate",
    "db:migrate": "pnpm --filter @ohmyapi/daemon db:migrate",
    "db:init": "pnpm --filter @ohmyapi/daemon db:init"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
