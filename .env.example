# ---- 服务 ----
# 监听地址；需要从其他设备访问时改为 0.0.0.0。
HOST=127.0.0.1
PORT=8000
# 前端开发服务器的 API 代理目标。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# ---- 会话 ----
# 浏览器访问的完整地址，不带末尾斜杠，用于校验请求来源；生产部署必填，开发时留空。
# APP_ORIGIN=https://ohmyapi.example.com
# 会话 Cookie 是否仅限 HTTPS；未设置时生产环境为 true，通过 HTTP 访问时设为 false。
SESSION_COOKIE_SECURE=false

# ---- 数据库 ----
# Compose 数据库密码，需与 DATABASE_URL 中的一致（URL 中需编码）；部署时请设置强密码。
POSTGRES_PASSWORD=ohmyapi_local
# Compose 数据库映射到本机的端口。
# POSTGRES_PORT=5432
DATABASE_URL=postgresql://ohmyapi:ohmyapi_local@127.0.0.1:5432/ohmyapi
# 连接池大小；连接超时，单位毫秒。
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# ---- 计费 ----
# 金额显示的货币标记：USD 或 CNY。
BILLING_CURRENCY=USD
# 创建用户时预填的初始余额，最多六位小数；非零时以一笔余额调整记入流水。
USER_INITIAL_BALANCE=0

# ---- 初始化 ----
# 首次执行 pnpm run setup 或 pnpm db:init 时创建的管理员，完成后删除这两项。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---- 密钥 ----
# 渠道凭据加密密钥，64 位十六进制；生成后保持不变，并与数据库一起备份。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CHANNEL_ENCRYPTION_KEY=

# ---- 网关 ----
# 请求体大小上限，单位字节，最大 32 MiB。
GATEWAY_MAX_BODY_BYTES=33554432
# 请求体上传总时长上限，单位毫秒。
GATEWAY_BODY_TIMEOUT_MS=120000
# 请求体上传停滞上限，单位毫秒；连续这么久未收到数据即中断。
GATEWAY_BODY_IDLE_TIMEOUT_MS=20000
# 上游流式响应停滞上限，单位毫秒。
GATEWAY_STREAM_IDLE_TIMEOUT_MS=300000
# 客户端断开后 API 渠道继续读取上游的时长上限，单位毫秒。
GATEWAY_DISCONNECT_DRAIN_TIMEOUT_MS=600000
# 解析用量时单个 SSE 事件、非流式响应体的大小上限，单位字节，最大 64 MiB。
# 解析会阻塞事件循环，超出上限时照常转发，该请求转入人工核对。
GATEWAY_MAX_USAGE_EVENT_BYTES=16777216
GATEWAY_MAX_USAGE_BODY_BYTES=16777216
# 每个用户的并发请求数与每分钟请求数上限。
GATEWAY_USER_CONCURRENCY=4
GATEWAY_USER_RPM=60
# 聚合渠道每个请求最多尝试的成员数；上游确认未执行请求时切换到下一个成员，1 表示不切换。
GATEWAY_MAX_ATTEMPTS=3
# 渠道连续失败多少次后熔断；熔断期间排在其他成员之后，冷却结束后放行一个试探请求。
GATEWAY_BREAKER_FAILURES=3
# 熔断冷却时长，单位毫秒；试探失败时加倍，不超过最大值。
GATEWAY_BREAKER_COOLDOWN_MS=30000
GATEWAY_BREAKER_MAX_COOLDOWN_MS=300000

# 内容审计：抽样比例和每用户每天的保底数量在渠道中配置，审核渠道和模型在“内容审计”页面设置。
# 每个用户每天最多审计的 session 数，包括保底抽样。
MODERATION_USER_DAILY_LIMIT=20
# 保底抽样选择请求数达到此值的 session。
MODERATION_FLOOR_MIN_REQUESTS=3
# session 空闲多久后送审，单位毫秒。
MODERATION_IDLE_MS=600000
# 同时采集的 session 上限，超出时不再抽中新的 session。
MODERATION_MAX_ACTIVE_SESSIONS=1000
# 每个 session 送审内容的字符上限，超出时保留最近的内容。
MODERATION_MAX_CONTENT_CHARS=48000
# 同时进行的审核请求数和单次审核的超时（毫秒）。
MODERATION_CONCURRENCY=2
MODERATION_TIMEOUT_MS=60000
# 违规概率达到疑似、违规的百分比阈值；判为违规还要求严重程度不低于 2。
MODERATION_SUSPECT_PERCENT=50
MODERATION_VIOLATION_PERCENT=85
# 判定通过的内容保留天数；预警内容在确认后保留的天数。
MODERATION_RETENTION_DAYS=7
MODERATION_ALERT_RETENTION_DAYS=90
