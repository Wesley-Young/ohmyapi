# ---- 服务 ----
# 监听地址；需要从其他设备访问时改为 0.0.0.0。
HOST=127.0.0.1
PORT=8000
# 前端开发服务器的 API 代理目标。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# ---- 会话 ----
# 浏览器访问的完整地址，不带末尾斜杠，用于校验请求来源；生产部署必填，开发时留空。
# APP_ORIGIN=https://ohmyapi.example.com
# 会话 Cookie 是否仅限 HTTPS；未设置时生产环境为 true，通过 HTTP 访问时设为 false。
SESSION_COOKIE_SECURE=false

# ---- 数据库 ----
# Compose 数据库密码，需与 DATABASE_URL 中的一致（URL 中需编码）；部署时请设置强密码。
POSTGRES_PASSWORD=ohmyapi_local
# Compose 数据库映射到本机的端口。
# POSTGRES_PORT=5432
DATABASE_URL=postgresql://ohmyapi:ohmyapi_local@127.0.0.1:5432/ohmyapi
# 连接池大小；连接超时，单位毫秒。
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# ---- 计费 ----
# 金额显示的货币标记：USD 或 CNY。
BILLING_CURRENCY=USD
# 创建用户时预填的初始余额，最多六位小数；非零时以一笔余额调整记入流水。
USER_INITIAL_BALANCE=0

# ---- 初始化 ----
# 首次执行 pnpm run setup 或 pnpm db:init 时创建的管理员，完成后删除这两项。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---- 密钥 ----
# 渠道凭据加密密钥，64 位十六进制；生成后保持不变，并与数据库一起备份。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CHANNEL_ENCRYPTION_KEY=

# ---- 网关 ----
# 请求体大小上限，单位字节，最大 32 MiB。
GATEWAY_MAX_BODY_BYTES=33554432
# 请求体上传总时长上限，单位毫秒。
GATEWAY_BODY_TIMEOUT_MS=120000
# 请求体上传停滞上限，单位毫秒；连续这么久未收到数据即中断。
GATEWAY_BODY_IDLE_TIMEOUT_MS=20000
# 上游流式响应停滞上限，单位毫秒。
GATEWAY_STREAM_IDLE_TIMEOUT_MS=300000
# 客户端断开后 API 渠道继续读取上游的时长上限，单位毫秒。
GATEWAY_DISCONNECT_DRAIN_TIMEOUT_MS=600000
# 解析用量时单个 SSE 事件、非流式响应体的大小上限，单位字节，最大 256 MiB。
GATEWAY_MAX_USAGE_EVENT_BYTES=134217728
GATEWAY_MAX_USAGE_BODY_BYTES=134217728
# 每个用户的并发请求数与每分钟请求数上限。
GATEWAY_USER_CONCURRENCY=4
GATEWAY_USER_RPM=60
