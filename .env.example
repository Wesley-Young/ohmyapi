# 需要从其他设备访问时，设置 HOST=0.0.0.0。
HOST=127.0.0.1
PORT=8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# pnpm dev 开发模式下不设置 APP_ORIGIN；生产部署时需填写浏览器实际访问的完整地址。
# 地址不带末尾斜杠，部署到服务器时替换为实际访问的主机地址。
# APP_ORIGIN=http://127.0.0.1:8000
# 开发和生产环境通过 HTTP 访问时，均需将安全 Cookie 设置为 false。
SESSION_COOKIE_SECURE=false

# 以下为本地 Compose 数据库默认配置；部署时请设置强密码，并保持下面两项密码一致。
# DATABASE_URL 中的密码需要进行 URL 编码。
POSTGRES_PASSWORD=ohmyapi_local
DATABASE_URL=postgresql://ohmyapi:ohmyapi_local@127.0.0.1:5432/ohmyapi
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# 金额展示标记，标记本身不触发汇率换算或实际货币兑换。
# 支持 USD、CNY，所有金额保留六位小数。
# 当前实现仍要求该配置与初始化时写入数据库的值一致。
BILLING_CURRENCY=USD

# 仅首次执行 pnpm run setup 或 pnpm db:init 时需要，无默认密码。
# 初始化完成后移除下面两项配置。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# 启动应用和保存渠道凭据时必需。
# 只需生成一次：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# 此密钥为 32 字节（64 位十六进制字符），后续保持不变，并与数据库一起备份。
CHANNEL_ENCRYPTION_KEY=
GATEWAY_MAX_BODY_BYTES=4194304
GATEWAY_USER_CONCURRENCY=4
GATEWAY_USER_RPM=60
