HOST=127.0.0.1
PORT=8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Set the public origin behind a production reverse proxy (no trailing slash).
# APP_ORIGIN=https://api.example.com
# Defaults to true when NODE_ENV=production; local HTTP development uses false.
# SESSION_COOKIE_SECURE=true

# Local compose database only. Use separate credentials in production.
DATABASE_URL=postgresql://ohmyapi:ohmyapi_local@127.0.0.1:5432/ohmyapi
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# Persisted at initialization; keep this value consistent on subsequent starts.
# Supported: USD, CNY. All amounts have six decimal places.
BILLING_CURRENCY=USD

# Required only for the first `pnpm db:init`. No default password.
# Remove these two values after initialization.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Disabled by default. Enabling forwarding also enables mandatory wallet reservation and billing.
GATEWAY_ENABLED=false
# Required to save channel credentials and to enable the gateway.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this 32-byte encryption key stable and back it up with the database.
CHANNEL_ENCRYPTION_KEY=
GATEWAY_MAX_BODY_BYTES=4194304
GATEWAY_USER_CONCURRENCY=4
GATEWAY_USER_RPM=60
