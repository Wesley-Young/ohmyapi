{
  "name": "@ohmyapi/daemon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./trpc": {
      "types": "./src/trpc/router.ts"
    }
  },
  "scripts": {
    "dev": "node --watch --conditions=@ohmyapi/source --env-file-if-exists=../.env src/index.ts",
    "start": "node --conditions=@ohmyapi/source --env-file=../.env ../scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "db:generate": "node --conditions=@ohmyapi/source --env-file-if-exists=../.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --conditions=@ohmyapi/source --env-file-if-exists=../.env src/cli/migrate.ts",
    "db:init": "node --conditions=@ohmyapi/source --env-file-if-exists=../.env src/cli/init.ts"
  },
  "dependencies": {
    "@fraqjs/color-log": "^1.1.1",
    "@fraqjs/kernel": "^1.1.1",
    "@fraqjs/plugin-hono": "^1.1.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@ohmyapi/protocols": "workspace:*",
    "@ohmyapi/relay": "workspace:*",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "^0.45.3",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
