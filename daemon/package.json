{
  "name": "@ohmyapi/daemon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./trpc": {
      "types": "./src/trpc/router.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../.env ../scripts/start.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.tools.json",
    "db:generate": "node --env-file-if-exists=../.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/cli/migrate.ts",
    "db:init": "tsx --env-file-if-exists=../.env src/cli/init.ts"
  },
  "dependencies": {
    "@fraqjs/color-log": "^1.1.1",
    "@fraqjs/kernel": "^1.1.1",
    "@fraqjs/plugin-hono": "^1.1.0",
    "@hono/node-server": "^2.1.3",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "js-tiktoken": "^1.0.21",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
